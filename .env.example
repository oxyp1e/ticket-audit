# Azure AI Document Intelligence (personal subscription, F0 tier)
AZURE_DI_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
AZURE_DI_KEY=<key from: az cognitiveservices account keys list -n <resource-name> -g rg-ticket-audit>
AZURE_DI_API_VERSION=2024-11-30
AZURE_DI_MODEL=prebuilt-layout

# Extraction engine: azure | local | truth (generator ground truth, used by tests)
EXTRACT_ENGINE=truth
